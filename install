#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
if [[ "$(uname -s)" != Darwin ]]; then
  echo 'This installer supports macOS only.' >&2
  exit 1
fi
if ! xcode-select -p >/dev/null 2>&1; then
  xcode-select --install
  printf 'Finish installing Command Line Tools, then rerun this command.\n' >&2
  exit 1
fi
if ! python3 -c 'import yaml' >/dev/null 2>&1; then
  PIP_BREAK_SYSTEM_PACKAGES=1 python3 -m pip install --user 'PyYAML>=6,<7'
fi
exec python3 -m src.install "$@"
